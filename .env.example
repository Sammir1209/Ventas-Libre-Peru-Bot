# ══════════════════════════════════════════════════════
# ⟡ Bot Ventas Libres Perú — Variables de Entorno
# ══════════════════════════════════════════════════════
# Copia este archivo como .env y completa los valores.
# En Render, inyecta estas variables desde el panel
# de Environment Variables del servicio.
# ══════════════════════════════════════════════════════

# ── Bot de Telegram (Obligatorio) ──────────────────
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# ── Owner(s) del Bot (Array JSON) ──────────────────
# IDs numéricos de los propietarios del bot.
# Formato: [id1, id2, ...]
OWNER_IDS=[7794982496]

# ── Canales/Grupos Obligatorios para Verificación ──
# Array JSON con los usernames o IDs numéricos de los
# canales/grupos donde el usuario debe estar suscrito.
# Ejemplo: ["@ventaslibresperu","@ventaslibresperu_chat"]
CHANNELS_TO_VERIFY=[]

# ── Link del Folder de Grupos Oficiales ────────────
# Link estético que se muestra a los usuarios.
# Ejemplo: https://t.me/addlist/XXXXXXXXX
GROUPS_FOLDER_LINK=

# ── PostgreSQL (Render Managed) ────────────────────
# URL de conexión proporcionada por Render.
# Formato: postgresql://user:pass@host:port/dbname
POSTGRES_URL=

# ── Redis (Render Managed) ─────────────────────────
# URL de conexión proporcionada por Render.
# Formato: redis://user:pass@host:port
REDIS_URL=

# ── Userbot MTProto (teleproto) ────────────────────
# Credenciales obtenidas de https://my.telegram.org
USERBOT_API_ID=
USERBOT_API_HASH=

# String de sesión generado al autenticar la cuenta
# del userbot. Usar el script de generación de sesión.
USERBOT_SESSION=

# ── Chat de Staff (Reportes /quemar) ───────────────
# ID numérico del grupo privado del staff.
# Obtener con /id en el grupo (ej. -1001234567890)
STAFF_CHAT_ID=

# ── Canal de Logs del Owner ────────────────────────
# ID numérico del canal privado para logs de moderación.
# Obtener con /id en el canal (ej. -1001234567890)
LOG_CHANNEL_ID=

# ── Puerto HTTP (Render) ───────────────────────────
# Render asigna automáticamente el puerto.
# No modificar manualmente.
PORT=10000

# ── Supabase (Storage de Pruebas /quemar) ──────────
# URL del proyecto Supabase.
# Formato: https://[REF].supabase.co
SUPABASE_URL=

# Service Role Key (JWT) — NUNCA exponer públicamente.
# Permite bypass de RLS para operaciones backend.
SUPABASE_SERVICE_KEY=
