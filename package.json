{
  "name": "bot-ventas-libres-peru",
  "version": "1.0.0",
  "description": "Bot Multipropósito y Sistema de Intermediación (Escrow) para Ventas Libres Perú",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
