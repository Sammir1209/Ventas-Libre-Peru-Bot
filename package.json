    "@napi-rs/canvas": "^1.0.6",
    "@supabase/supabase-js": "^2.112.3",
    "dotenv": "^16.4.0",
    "express": "^5.2.1",
    "grammy": "^1.35.0",
    "ioredis": "^5.4.0",
    "pg": "^8.13.0",
    "telegram": "^2.26.0",
    "tesseract.js": "^7.0.0"
  }
